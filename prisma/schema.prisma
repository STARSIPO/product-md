// Product.md — B2B wholesale marketplace for Moldova
//
// PORTABILITY CONTRACT
// -------------------
// This file is the canonical schema and it targets PostgreSQL — the production
// database and the one `prisma/migrations` is built against.
//
// Prisma does not accept env() for `provider`, so the SQLite variant used for
// zero-setup local development is derived from this file by scripts/prisma.mjs,
// which swaps only the datasource block and writes prisma/schema.sqlite.prisma
// (git-ignored). Always edit THIS file; never edit the generated one.
//
// For that derivation to stay valid, this schema deliberately uses only the
// common subset of both engines:
//
//   * no native enums          -> String columns validated by Zod + const unions in src/lib/constants
//   * no scalar lists          -> either a join table, or a JSON-encoded String column
//   * no Json column type      -> String columns holding JSON, read via src/lib/json.ts helpers
//   * no @db.* native types    -> lengths are enforced in the Zod layer
//   * money is always Int bani -> 1 MDL = 100 bani, never a float (see src/lib/money.ts)
//
// Anything Postgres-specific (GIN/pg_trgm indexes for search) lives in a migration
// guarded by the provider, never in this file. See docs/DATABASE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String?
  name            String
  locale          String    @default("ru")
  // platform role: USER | MODERATOR | ADMIN  (company-level buyer/seller roles live on Company)
  role            String    @default("USER")
  status          String    @default("ACTIVE") // ACTIVE | BLOCKED | DELETED
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  acceptedTermsAt DateTime?
  onboardedAt     DateTime?

  // Admin 2FA (TOTP). Secret is encrypted at rest with APP_SECRET.
  totpSecretEnc String?
  totpEnabledAt DateTime?

  lastLoginAt DateTime?
  blockedAt   DateTime?
  blockReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  companies         CompanyMember[]
  sessions          Session[]
  tokens            VerificationToken[]
  notifications     Notification[]
  notifPrefs        NotificationPreference[]
  favorites         Favorite[]
  savedSearches     SavedSearch[]
  messages          Message[]
  participants      ConversationParticipant[]
  complaintsFiled   Complaint[]               @relation("ComplaintReporter")
  complaintsHandled Complaint[]               @relation("ComplaintHandler")
  auditLogs         AuditLog[]
  dealEvents        DealEvent[]
  documentHistory   DocumentHistory[]
  moderationTasks   ModerationTask[]

  @@index([role, status])
  @@index([createdAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id     String  @id @default(cuid())
  userId String?
  // EMAIL_VERIFY | PASSWORD_RESET | PHONE_OTP | EMAIL_OTP | TOTP_ENROLL
  type   String
  // email address or phone number the token was issued for
  target String

  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, type])
  @@index([tokenHash])
  @@index([expiresAt])
}

/// Brute-force protection. One row per authentication attempt.
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String // normalized email or phone
  ip         String?
  success    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ip, createdAt])
}

/// Generic sliding-window rate limiter store (dev/single-node). Swap for Redis in prod.
model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}

// ---------------------------------------------------------------------------
// Companies
// ---------------------------------------------------------------------------

model Company {
  id          String  @id @default(cuid())
  slug        String  @unique
  legalName   String
  displayName String
  idno        String? // Moldovan company registration number (13 digits)
  orgType     String  @default("SRL") // SRL | SA | II | GT | PFA | NGO | OTHER
  description String?

  logoKey String?

  phone         String?
  email         String?
  website       String?
  contactPerson String?

  districtId String?
  localityId String?
  address    String?

  /// JSON: { mon: {from,to} | null, ... } — see src/lib/company-schema.ts
  workingHours   String?
  /// JSON string[] of PaymentMethod codes
  paymentMethods String?
  /// JSON string[] of locale codes the company communicates in
  languages      String?
  /// JSON string[] of district ids the company delivers to
  deliveryZones  String?

  deliveryTerms    String?
  minOrderBani     Int     @default(0)
  pickupAvailable  Boolean @default(false)
  deliveryPriceHint String?

  isBuyer  Boolean @default(false)
  isSeller Boolean @default(false)

  // denormalized aggregates, recomputed on write (see src/server/services/stats.ts)
  ratingAvg         Float @default(0)
  ratingCount       Int   @default(0)
  dealsCompleted    Int   @default(0)
  avgResponseMinutes Int?

  balanceBani  Int       @default(0)
  trialEndsAt  DateTime?

  status      String    @default("ACTIVE") // ACTIVE | SUSPENDED | BLOCKED
  blockReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  district District? @relation(fields: [districtId], references: [id])
  locality Locality? @relation(fields: [localityId], references: [id])

  members       CompanyMember[]
  photos        CompanyPhoto[]
  documents     Document[]
  badges        VerificationBadge[]
  products      Product[]
  requests      PurchaseRequest[]
  offers        Offer[]
  buyerDeals    Deal[]                    @relation("DealBuyer")
  sellerDeals   Deal[]                    @relation("DealSeller")
  reviewsWritten Review[]                 @relation("ReviewAuthor")
  reviewsGot    Review[]                  @relation("ReviewTarget")
  ledger        LedgerEntry[]
  payments      Payment[]
  favoritedBy   Favorite[]
  buyerConvos   Conversation[]            @relation("ConvoBuyer")
  sellerConvos  Conversation[]            @relation("ConvoSeller")
  participants  ConversationParticipant[]

  @@index([status, isSeller])
  @@index([status, isBuyer])
  @@index([districtId])
  @@index([ratingAvg])
}

model CompanyMember {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  role      String   @default("OWNER") // OWNER | MANAGER
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

model CompanyPhoto {
  id        String   @id @default(cuid())
  companyId String
  key       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, sortOrder])
}

/// Result of a verification check. Only this — never the underlying document — is public.
model VerificationBadge {
  id        String    @id @default(cuid())
  companyId String
  // PHONE | EMAIL | COMPANY | IDNO | DOCUMENTS | ANSA | BANK | TRUSTED_SUPPLIER
  type      String
  status    String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  grantedAt DateTime?
  expiresAt DateTime?
  note      String?
  updatedAt DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type])
  @@index([type, status])
}

model Document {
  id        String @id @default(cuid())
  companyId String
  // REGISTRATION | PERMIT | CERTIFICATE | ANSA | ORIGIN | BANK | OTHER
  type      String
  number    String?
  issuedAt  DateTime?
  expiresAt DateTime?

  /// Private storage key. Never exposed directly — always via a short-lived signed URL.
  fileKey  String
  fileName String
  mimeType String
  sizeByte Int

  status           String  @default("PENDING") // PENDING | APPROVED | REJECTED | CHANGES_REQUESTED | EXPIRED
  moderatorComment String?
  /// Owner may opt in to showing this document on the public company page.
  isPublic         Boolean @default(false)

  expiryNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  history  DocumentHistory[]
  products ProductDocument[]

  @@index([companyId, status])
  @@index([status, createdAt])
  @@index([expiresAt])
}

model DocumentHistory {
  id         String   @id @default(cuid())
  documentId String
  actorId    String?
  fromStatus String?
  toStatus   String
  comment    String?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id])

  @@index([documentId, createdAt])
}

// ---------------------------------------------------------------------------
// Geography
// ---------------------------------------------------------------------------

model District {
  id        String  @id
  nameRu    String
  nameRo    String
  kind      String  @default("RAION") // RAION | MUNICIPIU | UTA
  latitude  Float?
  longitude Float?

  localities Locality[]
  companies  Company[]

  @@index([kind])
}

model Locality {
  id         String  @id
  districtId String
  nameRu     String
  nameRo     String
  kind       String  @default("SAT") // ORAS | MUNICIPIU | SAT | COMUNA
  latitude   Float?
  longitude  Float?
  isMajor    Boolean @default(false)

  district District          @relation(fields: [districtId], references: [id], onDelete: Cascade)
  companies Company[]
  requests PurchaseRequest[]

  @@index([districtId])
  @@index([isMajor])
}

// ---------------------------------------------------------------------------
// Category tree, translations, synonyms, attributes
// ---------------------------------------------------------------------------

model Category {
  id       String  @id @default(cuid())
  parentId String?
  slug     String  @unique
  /// Materialized path of slugs: "meat/beef/chilled" — enables cheap subtree queries.
  path     String
  level    Int     @default(0)
  sortOrder Int    @default(0)
  isActive Boolean @default(true)
  isPopular Boolean @default(false)
  icon     String?
  /// Default unit code for listings in this category (KG, L, PCS, ...)
  defaultUnit String @default("KG")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent       Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]          @relation("CategoryTree")
  translations CategoryTranslation[]
  synonyms     CategorySynonym[]
  attributes   CategoryAttribute[]
  products     Product[]
  requests     PurchaseRequest[]

  @@index([parentId, sortOrder])
  @@index([path])
  @@index([isActive, isPopular])
}

model CategoryTranslation {
  id         String @id @default(cuid())
  categoryId String
  locale     String
  name       String
  /// Localized URL slug: /ru/category/meat vs /ro/categorie/carne
  slug       String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([locale])
}

/// Alternate spellings, colloquial names, plural forms and common misspellings.
/// Drives the "smart category" typeahead and query expansion in search.
model CategorySynonym {
  id         String  @id @default(cuid())
  categoryId String
  locale     String
  term       String
  /// lowercased, diacritics folded, ru/ro confusables normalized (see src/lib/normalize.ts)
  normalized String
  weight     Int     @default(100)
  isMisspelling Boolean @default(false)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([normalized])
  @@index([categoryId, locale])
}

model CategoryAttribute {
  id         String  @id @default(cuid())
  categoryId String
  key        String
  // TEXT | NUMBER | SELECT | MULTISELECT | BOOL | DATE
  type       String
  unit       String?
  isRequired Boolean @default(false)
  isFilterable Boolean @default(false)
  /// PRODUCT | REQUEST | BOTH — a request asks different questions than a listing.
  appliesTo  String  @default("BOTH")
  sortOrder  Int     @default(0)
  /// Attributes are inherited by descendant categories when true.
  inherited  Boolean @default(true)

  category     Category                       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations CategoryAttributeTranslation[]
  options      CategoryAttributeOption[]
  productValues ProductAttributeValue[]
  requestValues RequestAttributeValue[]

  @@unique([categoryId, key])
  @@index([categoryId, sortOrder])
}

model CategoryAttributeTranslation {
  id          String  @id @default(cuid())
  attributeId String
  locale      String
  label       String
  hint        String?

  attribute CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, locale])
}

model CategoryAttributeOption {
  id          String @id @default(cuid())
  attributeId String
  value       String
  sortOrder   Int    @default(0)

  attribute    CategoryAttribute                   @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  translations CategoryAttributeOptionTranslation[]
  productValues ProductAttributeValue[]

  @@unique([attributeId, value])
  @@index([attributeId, sortOrder])
}

model CategoryAttributeOptionTranslation {
  id       String @id @default(cuid())
  optionId String
  locale   String
  label    String

  option CategoryAttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, locale])
}

// ---------------------------------------------------------------------------
// Products (seller listings)
// ---------------------------------------------------------------------------

model Product {
  id         String @id @default(cuid())
  companyId  String
  categoryId String
  slug       String @unique

  title       String
  description String?

  priceBani Int
  currency  String @default("MDL")
  unit      String @default("KG")

  minOrderQty  Float @default(1)
  availableQty Float?

  originCountry   String?
  productionPlace String?
  manufacturer    String?
  batchNumber     String?
  producedAt      DateTime?
  bestBefore      DateTime?
  storageConditions String?
  storageTempC    String?
  allergens       String?
  composition     String?
  packaging       String?
  supplyRegularity String? // ONE_TIME | WEEKLY | BIWEEKLY | MONTHLY | SEASONAL | CONSTANT

  deliveryTerms     String?
  deliveryPriceBani Int?
  pickupAvailable   Boolean @default(false)
  /// JSON string[] of district ids
  deliveryRegions   String?

  videoUrl String?

  availability String @default("IN_STOCK") // IN_STOCK | PRE_ORDER | OUT_OF_STOCK

  // draft | pending | changes_requested | active | paused | rejected | sold_out | expired | archived | blocked
  status           String    @default("DRAFT")
  moderatorComment String?
  publishedAt      DateTime?
  expiresAt        DateTime?
  /// Set when the listing was auto-paused because the balance hit zero.
  pausedForBalance Boolean   @default(false)

  /// Normalized title + synonyms + category names, used by the SQL search engine.
  searchText String @default("")

  viewsCount     Int @default(0)
  favoritesCount Int @default(0)
  contactsCount  Int @default(0)

  // promotion flags (denormalized from Promotion for cheap sorting)
  promotedUntil    DateTime?
  bumpedAt         DateTime?
  isHighlighted    Boolean   @default(false)
  isUrgent         Boolean   @default(false)
  isHomepagePinned Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  photos     ProductPhoto[]
  priceTiers PriceTier[]
  attributes ProductAttributeValue[]
  documents  ProductDocument[]
  favorites  Favorite[]
  deals      Deal[]
  offers     Offer[]           @relation("OfferAlternativeProduct")
  conversations Conversation[]
  promotions Promotion[]
  statsDaily ProductStatDaily[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([companyId, status])
  @@index([status, priceBani])
  @@index([bumpedAt])
}

model ProductPhoto {
  id        String   @id @default(cuid())
  productId String
  key       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

/// Wholesale price break. minQty inclusive, maxQty inclusive, null maxQty = open ended.
model PriceTier {
  id        String @id @default(cuid())
  productId String
  minQty    Float
  maxQty    Float?
  priceBani Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, minQty])
}

model ProductAttributeValue {
  id          String  @id @default(cuid())
  productId   String
  attributeId String
  valueText   String?
  valueNumber Float?
  valueBool   Boolean?
  valueDate   DateTime?
  optionId    String?

  product   Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute CategoryAttribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  option    CategoryAttributeOption? @relation(fields: [optionId], references: [id])

  @@unique([productId, attributeId])
  @@index([attributeId, optionId])
  @@index([attributeId, valueNumber])
}

model ProductDocument {
  productId  String
  documentId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([productId, documentId])
}

model ProductStatDaily {
  id        String   @id @default(cuid())
  productId String
  day       String // YYYY-MM-DD in Europe/Chisinau
  views     Int      @default(0)
  contacts  Int      @default(0)
  favorites Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, day])
  @@index([day])
}

// ---------------------------------------------------------------------------
// Purchase requests (buyer RFQs)
// ---------------------------------------------------------------------------

model PurchaseRequest {
  id         String @id @default(cuid())
  companyId  String
  categoryId String
  slug       String @unique

  title       String
  description String?

  quantity Float
  unit     String @default("KG")

  desiredPriceBani Int?
  maxBudgetBani    Int?

  isRecurring Boolean @default(false)
  frequency   String? // WEEKLY | BIWEEKLY | MONTHLY | QUARTERLY

  firstDeliveryAt  DateTime?
  offersDeadlineAt DateTime?

  deliveryLocalityId String?
  deliveryAddress    String?
  supplierRadiusKm   Int?

  documentRequirements  String?
  packagingRequirements String?
  storageConditions     String?
  allowPartial          Boolean @default(false)
  verifiedOnly          Boolean @default(false)
  isUrgent              Boolean @default(false)

  visibility String @default("PUBLIC") // PUBLIC | PRIVATE

  // draft | active | receiving_offers | supplier_selected | in_progress | completed | cancelled | expired | disputed
  status String @default("DRAFT")

  offersCount Int @default(0)
  viewsCount  Int @default(0)

  searchText String @default("")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category         Category  @relation(fields: [categoryId], references: [id])
  deliveryLocality Locality? @relation(fields: [deliveryLocalityId], references: [id])

  attributes  RequestAttributeValue[]
  attachments RequestAttachment[]
  offers      Offer[]
  deals       Deal[]
  conversations Conversation[]

  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([companyId, status])
  @@index([offersDeadlineAt])
}

model RequestAttributeValue {
  id          String    @id @default(cuid())
  requestId   String
  attributeId String
  valueText   String?
  valueNumber Float?
  valueBool   Boolean?
  valueDate   DateTime?
  optionId    String?

  request   PurchaseRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  attribute CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([requestId, attributeId])
}

model RequestAttachment {
  id        String   @id @default(cuid())
  requestId String
  key       String
  fileName  String
  mimeType  String
  sizeByte  Int
  createdAt DateTime @default(now())

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Sealed commercial offers
// ---------------------------------------------------------------------------

/// SEALED BID. A supplier may only ever read its own offer; the buyer who owns the
/// request reads all of them. This is enforced in src/server/services/offers.ts and
/// covered by tests/integration/offer-privacy.test.ts — do not add a public read path.
model Offer {
  id              String @id @default(cuid())
  requestId       String
  sellerCompanyId String

  priceBani         Int
  quantity          Float
  unit              String @default("KG")
  deliveryPriceBani Int    @default(0)
  totalBani         Int
  currency          String @default("MDL")

  deliveryAt    DateTime?
  deliveryDays  Int?
  paymentMethod String? // CASH | TRANSFER | CARD | DEFERRED
  validUntil    DateTime?
  regularity    String?
  comment       String?

  alternativeProductId String?

  attachmentKey  String?
  attachmentName String?

  // SENT | VIEWED | SHORTLISTED | ACCEPTED | REJECTED | WITHDRAWN | EXPIRED
  status     String    @default("SENT")
  viewedAt   DateTime?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request            PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sellerCompany      Company         @relation(fields: [sellerCompanyId], references: [id], onDelete: Cascade)
  alternativeProduct Product?        @relation("OfferAlternativeProduct", fields: [alternativeProductId], references: [id])

  deals         Deal[]
  conversations Conversation[]

  @@unique([requestId, sellerCompanyId])
  @@index([sellerCompanyId, status])
  @@index([requestId, status])
}

// ---------------------------------------------------------------------------
// Deals
// ---------------------------------------------------------------------------

model Deal {
  id     String @id @default(cuid())
  number String @unique

  buyerCompanyId  String
  sellerCompanyId String

  productId String?
  requestId String?
  offerId   String?

  title             String
  quantity          Float
  unit              String @default("KG")
  unitPriceBani     Int
  deliveryPriceBani Int    @default(0)
  totalBani         Int
  currency          String @default("MDL")

  deliveryAddress String?
  deliveryAt      DateTime?
  paymentMethod   String?
  comment         String?

  // AWAITING_CONFIRMATION | CONFIRMED | PREPARING | SHIPPED | DELIVERED | COMPLETED | CANCELLED | DISPUTED
  status String @default("AWAITING_CONFIRMATION")

  buyerConfirmedAt  DateTime?
  sellerConfirmedAt DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyerCompany  Company          @relation("DealBuyer", fields: [buyerCompanyId], references: [id])
  sellerCompany Company          @relation("DealSeller", fields: [sellerCompanyId], references: [id])
  product       Product?         @relation(fields: [productId], references: [id])
  request       PurchaseRequest? @relation(fields: [requestId], references: [id])
  offer         Offer?           @relation(fields: [offerId], references: [id])

  events        DealEvent[]
  reviews       Review[]
  conversations Conversation[]

  @@index([buyerCompanyId, status])
  @@index([sellerCompanyId, status])
  @@index([status, createdAt])
}

model DealEvent {
  id         String   @id @default(cuid())
  dealId     String
  actorId    String?
  fromStatus String?
  toStatus   String
  comment    String?
  createdAt  DateTime @default(now())

  deal  Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([dealId, createdAt])
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

model Conversation {
  id String @id @default(cuid())
  // PRODUCT | REQUEST | OFFER | DEAL | DIRECT
  type String

  productId String?
  requestId String?
  offerId   String?
  dealId    String?

  buyerCompanyId  String
  sellerCompanyId String

  subject       String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  product Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  request PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offer   Offer?           @relation(fields: [offerId], references: [id], onDelete: Cascade)
  deal    Deal?            @relation(fields: [dealId], references: [id], onDelete: Cascade)

  buyerCompany  Company @relation("ConvoBuyer", fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  sellerCompany Company @relation("ConvoSeller", fields: [sellerCompanyId], references: [id], onDelete: Cascade)

  messages     Message[]
  participants ConversationParticipant[]

  @@unique([type, productId, buyerCompanyId, sellerCompanyId])
  @@unique([type, requestId, buyerCompanyId, sellerCompanyId])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  companyId      String
  lastReadAt     DateTime?
  isBlocked      Boolean   @default(false)
  isArchived     Boolean   @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, isArchived])
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  senderUserId   String?
  /// USER | SYSTEM — system messages are rendered from i18n keys, never raw text.
  kind           String @default("USER")
  body           String
  /// JSON params for SYSTEM messages
  params         String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?               @relation(fields: [senderUserId], references: [id])
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id        String @id @default(cuid())
  messageId String
  key       String
  fileName  String
  mimeType  String
  sizeByte  Int

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// ---------------------------------------------------------------------------
// Favorites, saved searches, notifications
// ---------------------------------------------------------------------------

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String?
  companyId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([userId, companyId])
  @@index([userId, createdAt])
}

model SavedSearch {
  id     String @id @default(cuid())
  userId String
  name   String
  /// JSON-encoded ProductSearchParams
  query  String
  /// PRODUCT | REQUEST
  target String @default("PRODUCT")

  notifyNew      Boolean   @default(true)
  notifyPriceDrop Boolean  @default(false)
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([notifyNew])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  /// i18n key suffix, see src/lib/constants/notifications.ts
  type   String
  /// JSON params interpolated into the localized template
  params String?

  entityType String?
  entityId   String?
  url        String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id     String  @id @default(cuid())
  userId String
  type   String
  inApp  Boolean @default(true)
  email  Boolean @default(true)
  sms    Boolean @default(false)
  push   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

/// Outbox for every channel adapter (email/SMS/push). Lets the UI show delivery state
/// and makes retries safe. Written by src/server/notifications/dispatch.ts.
model NotificationDelivery {
  id        String @id @default(cuid())
  channel   String // EMAIL | SMS | PUSH | TELEGRAM
  recipient String
  template  String
  /// JSON payload
  payload   String
  status    String    @default("PENDING") // PENDING | SENT | FAILED
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Reviews & complaints
// ---------------------------------------------------------------------------

model Review {
  id              String @id @default(cuid())
  dealId          String
  authorCompanyId String
  targetCompanyId String
  /// BUYER_TO_SELLER | SELLER_TO_BUYER
  direction       String

  overall Int
  /// JSON: buyer -> {quality,description,delivery,communication,documents}
  /// seller -> {communication,payment,agreement}
  criteria String

  comment String?
  status  String @default("PUBLISHED") // PUBLISHED | HIDDEN | PENDING

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal          Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  authorCompany Company      @relation("ReviewAuthor", fields: [authorCompanyId], references: [id], onDelete: Cascade)
  targetCompany Company      @relation("ReviewTarget", fields: [targetCompanyId], references: [id], onDelete: Cascade)
  reply         ReviewReply?

  @@unique([dealId, direction])
  @@index([targetCompanyId, status, createdAt])
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String   @unique
  body      String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Complaint {
  id             String @id @default(cuid())
  reporterUserId String
  /// PRODUCT | COMPANY | MESSAGE | OFFER | DOCUMENT | REVIEW | DEAL | REQUEST
  entityType     String
  entityId       String
  /// FRAUD | PROHIBITED | WRONG_PRICE | FAKE_DOCUMENTS | UNSAFE_PRODUCT | SPAM | ABUSE | COPYRIGHT | OTHER
  reason         String
  description    String?

  status      String  @default("OPEN") // OPEN | IN_REVIEW | RESOLVED | REJECTED
  resolution  String?
  handledById String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  reporter  User  @relation("ComplaintReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  handledBy User? @relation("ComplaintHandler", fields: [handledById], references: [id])

  @@index([status, createdAt])
  @@index([entityType, entityId])
}

model ModerationTask {
  id         String @id @default(cuid())
  /// PRODUCT | REQUEST | DOCUMENT | COMPANY | REVIEW | COMPLAINT
  entityType String
  entityId   String
  kind       String @default("REVIEW_NEW") // REVIEW_NEW | REVIEW_EDIT | COMPLAINT
  status     String @default("OPEN") // OPEN | CLAIMED | DONE
  priority   Int    @default(0)

  assignedToId String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  assignedTo User? @relation(fields: [assignedToId], references: [id])

  @@unique([entityType, entityId, status])
  @@index([status, priority, createdAt])
}

model AuditLog {
  id         String  @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  /// JSON snapshot of the changed fields, before/after
  oldValue   String?
  newValue   String?
  reason     String?
  ip         String?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Money: append-only ledger, payments, promotions, settings
// ---------------------------------------------------------------------------

/// Append-only. Company.balanceBani is a cache of the latest balanceAfterBani and is
/// only ever written inside the same transaction that appends an entry here.
/// Every write must supply an idempotencyKey — that unique index is what makes the
/// daily listing charge safe to re-run. See src/server/services/ledger.ts.
model LedgerEntry {
  id        String @id @default(cuid())
  companyId String

  /// Signed: positive credits the company, negative debits it. Always bani.
  amountBani       Int
  currency         String @default("MDL")
  /// TOP_UP | LISTING_DAILY | PROMOTION | REFUND | BONUS | ADJUSTMENT
  type             String
  balanceBeforeBani Int
  balanceAfterBani  Int

  description String?
  entityType  String?
  entityId    String?

  idempotencyKey String @unique

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([type, createdAt])
}

model Payment {
  id        String @id @default(cuid())
  companyId String

  provider    String // mock | maib | victoriabank | paynet | mia
  providerRef String?
  amountBani  Int
  currency    String  @default("MDL")
  status      String  @default("PENDING") // PENDING | SUCCEEDED | FAILED | REFUNDED
  failureCode String?

  idempotencyKey String  @unique
  returnUrl      String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([status])
}

/// Raw inbound webhooks. Stored before processing so a replay is detectable and a
/// failed handler can be retried without losing the payload.
model WebhookEvent {
  id         String @id @default(cuid())
  provider   String
  externalId String
  /// raw request body
  payload    String
  signatureValid Boolean @default(false)

  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([processedAt])
}

model Promotion {
  id        String @id @default(cuid())
  productId String
  /// BUMP | PIN_CATEGORY | HOMEPAGE | HIGHLIGHT | URGENT | NEWSLETTER
  type      String
  startsAt  DateTime @default(now())
  endsAt    DateTime
  priceBani Int
  ledgerEntryId String?

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, endsAt])
  @@index([type, endsAt])
}

/// Runtime-editable pricing so an admin can change tariffs without a deploy.
model Tariff {
  key       String   @id
  priceBani Int
  /// DAY | ITEM | PERCENT
  unit      String   @default("DAY")
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  /// optional JSON payload
  payload     String?
  updatedAt   DateTime @updatedAt
}

model Setting {
  key       String   @id
  /// JSON-encoded value
  value     String
  updatedAt DateTime @updatedAt
}

/// Feeds "recent searches" and "popular queries" on the search overlay.
model SearchQueryLog {
  id           String   @id @default(cuid())
  userId       String?
  query        String
  normalized   String
  resultsCount Int      @default(0)
  locale       String   @default("ru")
  createdAt    DateTime @default(now())

  @@index([normalized, createdAt])
  @@index([userId, createdAt])
}
