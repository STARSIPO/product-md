# =============================================================================
# Product.md — environment configuration
# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env`.
# Every value below is read through src/env.ts, which validates it with Zod at
# boot and fails fast with a readable message instead of crashing at runtime.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Two supported providers. PostgreSQL is the production target; SQLite exists so a
# developer can clone and run with zero infrastructure. See docs/DATABASE.md.
#
#   Local, zero setup (default):
#     DATABASE_PROVIDER="sqlite"
#     DATABASE_URL="file:./dev.db"
#
#   PostgreSQL via docker-compose (recommended, matches production):
#     DATABASE_PROVIDER="postgresql"
#     DATABASE_URL="postgresql://productmd:productmd@localhost:5432/productmd?schema=public"
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"
DEFAULT_LOCALE="ru"

# Master secret. Signs session cookies and encrypts TOTP secrets at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# MUST be at least 32 characters. Rotating it invalidates all sessions.
APP_SECRET="dev-only-insecure-secret-change-me-min-32-chars"

# Session lifetime in days.
SESSION_TTL_DAYS="30"

# -----------------------------------------------------------------------------
# Storage (photos + private documents)
# -----------------------------------------------------------------------------
# "local" writes to ./.storage and serves documents through a signed app route.
# "s3"    targets any S3-compatible bucket (AWS S3, MinIO, Cloudflare R2, Backblaze).
STORAGE_DRIVER="local"

# Only required when STORAGE_DRIVER="s3"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET_PUBLIC=""
S3_BUCKET_PRIVATE=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
# Public base URL for objects in the public bucket (CDN domain).
S3_PUBLIC_BASE_URL=""

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# "console" renders every message to ./.mail as .html and logs it. Nothing leaves
# the machine. Use it in development — it is not a fake SMTP connection.
# "smtp" requires the SMTP_* values below.
MAIL_DRIVER="console"
MAIL_FROM="Product.md <no-reply@product.md>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# -----------------------------------------------------------------------------
# SMS
# -----------------------------------------------------------------------------
# "mock" stores the OTP in the database and prints it to the server log so phone
# signup is testable locally. It does NOT pretend to have sent an SMS.
# Set to a real provider key only once credentials exist — see docs/ARCHITECTURE.md.
SMS_DRIVER="mock"
SMS_API_KEY=""
SMS_SENDER="ProductMD"

# -----------------------------------------------------------------------------
# Payments (balance top-up only — Product.md never processes goods payments)
# -----------------------------------------------------------------------------
# "mock" simulates the redirect + webhook loop locally with a signed test payload.
# Real drivers: maib | victoriabank | paynet | mia — none are wired without keys.
PAYMENT_DRIVER="mock"
PAYMENT_WEBHOOK_SECRET="dev-only-webhook-secret-change-me"
MAIB_MERCHANT_ID=""
MAIB_PRIVATE_KEY=""
VICTORIABANK_MERCHANT_ID=""
VICTORIABANK_SECRET=""
PAYNET_MERCHANT_ID=""
PAYNET_SECRET=""

# -----------------------------------------------------------------------------
# Billing
# -----------------------------------------------------------------------------
# Charged per active listing per day, in bani (100 bani = 1 MDL).
LISTING_DAILY_PRICE_BANI="100"
# Free trial granted to a new seller company, in days.
SELLER_TRIAL_DAYS="30"
# Warn the owner when the balance drops below this many bani.
LOW_BALANCE_THRESHOLD_BANI="1000"
# Shared secret for POST /api/cron/daily-billing (Authorization: Bearer <value>).
CRON_SECRET="dev-only-cron-secret-change-me"

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
# Error tracking is behind an adapter. Leave empty to use the console reporter.
SENTRY_DSN=""
LOG_LEVEL="info"
